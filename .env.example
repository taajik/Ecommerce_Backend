
## --> RENAME THIS FILE TO .env AND FILL IN THE VALUES <-- ##



## -------- Django settings --------
# See https://docs.djangoproject.com/en/5.2/ref/settings/

DJANGO_SECRET_KEY=randomly-generated-secret-key
# generate a secret key: django.core.management.utils.get_random_secret_key()
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
# in development, leave DJANGO_ALLOWED_HOSTS empty for default



## -------- Database (Postgres) --------
# See https://hub.docker.com/_/postgres

# postgres superuser
POSTGRES_USER=postgres
POSTGRES_DB=postgres
POSTGRES_PASSWORD=postgres-admin-password

# application user and database
DB_NAME=myapp
DB_USER=myapp_user
DB_PASSWORD=myapp-database-password
DB_HOST=db
DB_PORT=5432



## -------- NGINX config --------
# See https://nginx.org/en/docs/dirindex.html

SERVER_NAMES="example.com www.example.com"
